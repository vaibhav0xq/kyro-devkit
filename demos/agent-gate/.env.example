# Copy to .env next to this file. Every variable is optional: with none of
# them set the demo runs a dry-run against the live Kyro API with zero
# credentials. .env is gitignored; only this example is committed.

# dry-run prints the Circle CLI command for every proceed and runs nothing.
# live spawns it once per proceed with an --idempotency-key and needs
# AGENT_WALLET_ADDRESS plus a Circle CLI testnet agent session on this machine
# (circle wallet login <email> --type agent --testnet). --simulate is refused in live.
AGENT_GATE_MODE=dry-run

# The paying agent wallet on ARC-TESTNET (circle wallet list --chain ARC-TESTNET --type agent).
# Optional in dry-run: when set it fills --address in the printed command and
# the policy refuses payments to this address. Required in live.
# AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Path to the Circle CLI binary when it is not on PATH. Displayed in dry-run, spawned in live.
# On Windows use the full path of the npm shim (what "where circle" prints); a .cmd or .bat
# there is started through cmd.exe because Node will not spawn batch files directly.
# CIRCLE_BIN=circle
# CIRCLE_BIN=C:\Users\<you>\AppData\Roaming\npm\circle.cmd

# Live only: how long one Circle CLI spawn may run before the demo stops it and
# reports the transfer as unknown. The CLI polls for about 180 s on its own,
# so leave it room to answer. Minimum 1000.
CIRCLE_TIMEOUT_MS=240000

# The demo never sets the Circle CLI's own switches for you. Export them in
# your shell if you want a non-interactive live run, after reading what they do:
# CIRCLE_ACCEPT_TERMS=1, DO_NOT_TRACK=1, CIRCLE_VERSION_CHECK=0.

# Operator caps in USDC, independent of Kyro. Circle spending policies are
# mainnet only, so every limit in this demo lives in the agent.
MAX_USDC_PER_TRANSFER=5
MAX_USDC_PER_RUN=10

# Kyro read timeout. Short on purpose so the fail-closed path is visible.
KYRO_TIMEOUT_MS=8000

# Minimum gap between decision reads. Anonymous callers get 20 rate units per minute per IP.
KYRO_MIN_INTERVAL_MS=1500

# 1 asks a human on every hold (terminal only). Same as --interactive.
AGENT_GATE_INTERACTIVE=0

# Where the JSONL audit log goes, relative to this directory. Gitignored by *.log.
# AGENT_GATE_AUDIT_LOG=agent-gate.audit.log
